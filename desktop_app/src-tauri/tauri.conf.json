{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "医院财务凭证自动化系统",
  "version": "1.1.0",
  "identifier": "com.hospital.voucher",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "石家庄心理医院 - 财务凭证与进销存自动化工作台",
        "width": 1180,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg"
    ],
    "resources": ["resources/*"],
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
